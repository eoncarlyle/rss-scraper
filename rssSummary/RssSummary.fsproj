<?xml version="1.0" encoding="utf-8" ?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RssScraper</AssemblyName>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="Anthropic" Version="12.9.0" />
    <PackageReference Include="FSharp.Data" Version="8.1.3" />
    <PackageReference Include="FsHttp" Version="15.0.3" />
    <PackageReference Include="Giraffe" Version="6.4.0" />
    <PackageReference Include="Giraffe.ViewEngine" Version="2.0.0-alpha-1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Tiktoken" Version="3.1.4" />
    <PackageReference Include="Google.GenAI" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DomainModels.fs" />
    <Compile Include="Serialisation.fs" />
    <Compile Include="OriginalSourceFeeds.fs" />
    <Compile Include="Queries.fs" />
    <Compile Include="AppAnthropic.fs" />
    <Compile Include="AppGemini.fs" />
    <Compile Include="DerivedSourceFeeds.fs" />
    <Compile Include="Program.fs" />
    <Content Include="Schema\sources.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Schema\artemis.rss" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Schema" />
  </ItemGroup>
</Project>
