<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RssSummary</AssemblyName>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PackageId>RssSummary</PackageId>
    <RootNamespace>RssSummary</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="Anthropic" Version="12.9.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.19.4" />
    <PackageReference Include="FSharp.Data" Version="8.1.3" />
    <PackageReference Include="FsHttp" Version="15.0.3" />
    <PackageReference Include="Giraffe.ViewEngine" Version="1.4.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.14.0" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Tiktoken" Version="3.1.4" />
    <PackageReference Include="Google.GenAI" Version="1.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="sink-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="source-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Schema\artemis.rss" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="DomainModel.fs" />
    <Compile Include="Serialisation.fs" />
    <Compile Include="ObjectStorage.fs" />
    <Compile Include="SourceFeeds.fs" />
    <Compile Include="LanguageModelCommon.fs" />
    <Compile Include="AppAnthropic.fs" />
    <Compile Include="AppGeminiCommon.fs" />
    <Compile Include="DerivedFeeds.fs" />
    <Compile Include="SinkFeeds.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Schema" />
  </ItemGroup>
</Project>
