<?xml version="1.0" encoding="utf-8" ?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PackageId>RssServer</PackageId>
    <RootNamespace>RssScraper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.4.0" />
    <PackageReference Include="FsHttp" Version="15.0.3" />
    <PackageReference Include="Giraffe" Version="6.4.0" />
    <PackageReference Include="Giraffe.ViewEngine" Version="1.4.*" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.19.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../rssSummary/RssSummary.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Parse.fs" />
    <Compile Include="Caching.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
